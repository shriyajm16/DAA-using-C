#include <stdio.h>
#include <stdlib.h>

int topo[10], k = -1;

void dfs(int a[10][10], int n, int visited[10], int source)
{
    int i;
    visited[source] = 1;

    for(i = 0; i < n; i++)
    {
        if(a[source][i] == 1 && visited[i] == 0)
        {
            dfs(a, n, visited, i);
        }
    }

    topo[++k] = source;
}

int main()
{
    int i, j, a[10][10], n, visited[10];

    printf("Read number of nodes: ");
    scanf("%d", &n);

    printf("Read the adjacency matrix:\n");

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    for(i = 0; i < n; i++)
    {
        visited[i] = 0;
    }

    for(i = 0; i < n; i++)
    {
        if(visited[i] == 0)
        {
            dfs(a, n, visited, i);
        }
    }

    printf("Topological Order:\n");

    for(i = k; i >= 0; i--)
    {
        printf("%d\t", topo[i]+1);
    }

    return 0;
}
